# Per-scanner toggles for the security MCP server and CLI.
#
# Copy this file to `.env` and uncomment any scanner you want to disable.
# A scanner is disabled when its variable is set to one of:
#   false / 0 / no / off / disable / disabled   (case-insensitive)
# Anything else, or leaving it unset, keeps the scanner enabled.
#
# The variable name is the scanner name uppercased with '-' replaced by '_'.
# Disabled scanners are skipped everywhere: the aggregated static_scan /
# dynamic_scan tools, the per-scanner MCP tools, and the CLI.

# --- SCA ---
# TRIVY=false
# OSV_SCANNER=false

# --- IaC misconfiguration ---
# TRIVY_MISCONFIG=false

# --- License compliance ---
# TRIVY_LICENSE=false

# --- Secret detection ---
# GITLEAKS=false
# NOSEY_PARKER=false
# TITUS=false
# KINGFISHER=false
# TRUFFLEHOG=false
# BETTERLEAKS=false

# --- SAST ---
# OPENGREP=false
# CODEQL=false

# --- Pipeline (CI/CD) ---
# PLUMBER=false

# --- DAST (dynamic) ---
# NUCLEI=false
# ZAPROXY=false

# --- Scan target confinement (optional, recommended) ---
# When set, every static scan target (project_dir) must resolve to a path inside
# this directory tree; targets outside it are rejected. This bounds what the
# scanners — and an agent driving the MCP tools — can read, preventing scans of
# arbitrary locations such as / or ~/.ssh. Leave unset to allow any directory.
# SECURITY_MCP_SCAN_ROOT=/srv/code